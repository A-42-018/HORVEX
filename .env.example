# Copy to .env and fill in. Only VITE_-prefixed variables reach the browser.
# Never put the Supabase service_role key here.

# Supabase (Phase 2)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Live domain, no trailing slash (e.g. https://wristory.com.bd). Used for canonical
# URLs, og:url, JSON-LD and sitemap.xml. Without it, canonicals and sitemap.xml are skipped.
VITE_SITE_URL=
